{
  "promptDirs": [
    ".prompts",
    "node_modules/pupt/prompts"
  ],
  "historyDir": ".pthistory",
  "defaultCmd": "claude",
  "defaultCmdArgs": [
    "--permission-mode",
    "acceptEdits"
  ],
  "defaultCmdOptions": {
    "Continue with last context?": "--continue"
  },
  "autoReview": true,
  "autoRun": true,
  "gitPromptDir": ".git-prompts",
  "version": "7.0.0",
  "outputCapture": {
    "enabled": false,
    "directory": ".pthistory",
    "maxSizeMB": 50,
    "retentionDays": 30
  },
  "libraries": []
}
